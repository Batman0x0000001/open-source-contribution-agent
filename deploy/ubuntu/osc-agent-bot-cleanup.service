[Unit]
Description=Clean expired OSA Agent Bot state

[Service]
Type=oneshot
User=osa-control
Group=osa-shared
UMask=0007
EnvironmentFile=/etc/osc-agent/bot.env
ExecStart=/opt/osc-agent/current/venv/bin/osc-agent bot cleanup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/osc-agent
ReadOnlyPaths=/etc/osc-agent
