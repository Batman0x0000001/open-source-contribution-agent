[Unit]
Description=OSC Agent Trusted Worker
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
User=osc-worker
Group=osc-shared
SupplementaryGroups=docker
UMask=0007
EnvironmentFile=/etc/osc-agent/worker.env
ExecStartPre=/opt/osc-agent/current/venv/bin/osc-agent-bot schema-check
ExecStart=/opt/osc-agent/current/venv/bin/osc-agent-bot worker
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/osc-agent
ReadOnlyPaths=/etc/osc-agent

[Install]
WantedBy=multi-user.target
