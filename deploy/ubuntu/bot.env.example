OSC_AGENT_GITHUB_APP_ID=12345
OSC_AGENT_GITHUB_APP_PRIVATE_KEY_PATH=/etc/osc-agent/github-app.pem
OSC_AGENT_GITHUB_WEBHOOK_SECRET=replace-with-long-random-secret
OSC_AGENT_GITHUB_PUBLIC_URL=https://osc-agent.example.com
OSC_AGENT_BOT_DATABASE_PATH=/var/lib/osc-agent/bot.sqlite3
OSC_AGENT_BOT_WORKSPACE_ROOT=/var/lib/osc-agent/workspaces
OSC_AGENT_BOT_REPOSITORIES_CONFIG=/etc/osc-agent/config.yml
OSC_AGENT_BOT_BIND_HOST=127.0.0.1
OSC_AGENT_BOT_BIND_PORT=8080
OSC_AGENT_GITHUB_COMMIT_NAME=osc-agent
OSC_AGENT_GITHUB_COMMIT_EMAIL=osc-bot@example.com
MODEL_ID=replace-with-model-id
