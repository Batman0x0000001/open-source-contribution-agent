[Unit]
Description=OSA Agent GitHub App Control Service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=osa-control
Group=osa-shared
UMask=0007
EnvironmentFile=/etc/osc-agent/bot.env
ExecStartPre=/opt/osc-agent/current/venv/bin/osc-agent-bot schema-check
ExecStart=/opt/osc-agent/current/venv/bin/osc-agent-bot control
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/osc-agent
ReadOnlyPaths=/etc/osc-agent

[Install]
WantedBy=multi-user.target
