[Unit]
Description=OSA Agent GitHub App Control Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=osa-control
Group=osa-shared
UMask=0007
EnvironmentFile=/etc/osc-agent/bot.env
ExecStartPre=/opt/osc-agent/current/venv/bin/osc-agent deploy schema-check
ExecStart=/opt/osc-agent/current/venv/bin/osc-agent bot serve
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=120
StartLimitBurst=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/osc-agent
ReadOnlyPaths=/etc/osc-agent

[Install]
WantedBy=multi-user.target
