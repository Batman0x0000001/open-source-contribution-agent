ANTHROPIC_API_KEY=replace-with-model-api-key
ANTHROPIC_BASE_URL=https://api.anthropic.com
MODEL_ID=replace-with-model-id
OSC_AGENT_BOT_DATABASE_PATH=/var/lib/osc-agent/bot.sqlite3
OSC_AGENT_BOT_WORKSPACE_ROOT=/var/lib/osc-agent/workspaces
OSC_AGENT_BOT_REPOSITORIES_CONFIG=/etc/osc-agent/repositories.yml
OSC_AGENT_BOT_WORKER_ID=worker-1
OSC_AGENT_BOT_MAX_CONCURRENT_JOBS=1
